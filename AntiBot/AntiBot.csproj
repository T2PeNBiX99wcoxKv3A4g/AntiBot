<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Generate embedded file manifest when the shared static server serves Resources/wwwroot -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RootNamespace>AntiBot</RootNamespace>
        <Version>0.2.0</Version>
        <Description>VRChat anti-bot tooling with a live VRChat log viewer.</Description>
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <!-- Windows Hello needs the WinRT projection, which is only compiled into Windows builds. -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DisableHello)' != 'true'">
        <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DisableHello)' != 'true'">
        <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.26100.87]" />
        <Reference Include="Microsoft.Windows.SDK.NET">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="WinRT.Runtime">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <!-- PhotinoNETUtils is referenced as a DLL, so its own dependencies have to be listed here too. -->
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="QRCoder" Version="1.8.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="PhotinoNETUtils">
            <HintPath>Libs\PhotinoNETUtils.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

</Project>
