<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-user installer: AntiBot keeps its settings and its session under %APPDATA% and %LOCALAPPDATA%,
    so it never needs elevation and never writes to a location another user shares.

    The published build is a single executable, so the package is one component plus the shortcuts.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="AntiBot"
             Manufacturer="yukiyosanako"
             Version="$(var.Version)"
             UpgradeCode="b7c1e4a2-5d3f-4a8b-9c6e-2f1d3a4b5c6d"
             Scope="perUser"
             Compressed="yes"
             InstallerVersion="500">

        <SummaryInformation Description="AntiBot VRChat anti-bot tooling" Manufacturer="yukiyosanako" />

        <!--
            Force the per-user context even when the MSI is started from an elevated shell: the app
            lives in %LOCALAPPDATA% and keeps its settings under %APPDATA%, so a per-machine copy
            would be shared by every user and none of them could use it properly.
        -->
        <Property Id="ALLUSERS" Value="2" />
        <Property Id="MSIINSTALLPERUSER" Value="1" />

        <!-- A reinstall of the same version replaces the files instead of failing. -->
        <MajorUpgrade AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer version of AntiBot is already installed." />

        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

        <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/T2PeNBiX99wcoxKv3A4g/AntiBot" />
        <Property Id="ARPNOMODIFY" Value="1" />

        <Feature Id="Main" Title="AntiBot" Level="1">
            <ComponentGroupRef Id="ApplicationFiles" />
        </Feature>
    </Package>

    <Fragment>
        <!-- Same place per-user installers normally use, so no elevation is involved. -->
        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsFolder" Name="Programs">
                <Directory Id="INSTALLFOLDER" Name="AntiBot" />
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder" />

        <StandardDirectory Id="DesktopFolder" />
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ApplicationFiles">
            <Component Id="Application" Directory="INSTALLFOLDER" Guid="*">
                <File Id="AntiBotExe" Source="$(var.SourceDir)\AntiBot.exe" KeyPath="yes">
                    <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="AntiBot"
                              Description="AntiBot VRChat anti-bot tooling" />
                    <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="AntiBot"
                              Description="AntiBot VRChat anti-bot tooling" />
                </File>
                <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
